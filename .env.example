# ============================================
# Canal Dark — Pipeline Autônomo
# Copie para .env e preencha com seus valores
# ============================================

# --- Gemini / Google AI Studio ---
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de texto para roteiros
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Modelo de imagem (free tier)
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp

# --- Edge-TTS (vozes PT-BR) ---
TTS_VOICE_MALE=pt-BR-AntonioNeural
TTS_VOICE_FEMALE=pt-BR-FranciscaNeural

# --- Telegram (alertas de erro) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Instagram Graph API (Fase 2+) ---
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- TikTok Content Posting API (Fase 2+) ---
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=

# --- Paths (ajuste se necessário) ---
DATA_DIR=./data
CONFIG_DIR=./config
OUTPUT_DIR=./data/output
